# Copy to .env for local development. On Render, set the same names as environment
# variables (with real values) instead.

# Required in production: a long random string (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=change-me

# Local PostgreSQL in Docker (docker-compose.yml reads these three).
POSTGRES_USER=enduro_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atv_shop
# Neon's "postgresql://..." URL also works (the driver is added in app/config.py).
DATABASE_URL=postgresql+psycopg://enduro_admin:change-me@localhost:5433/atv_shop

STRIPE_SECRET_KEY=change-me

# Locally: Google's public test keys (the widget always passes and shows a warning).
# In production: real keys registered for the Render domain (required when enabled).
CAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Production only: true (cookie sent over HTTPS only) and the site's domain(s),
# comma-separated. Leave them like this locally.
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=
